{
  "name": "minehonk",
  "version": "5.0.0",
  "private": true,
  "description": "MineHonk - a multiplayer voxel survival sandbox",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:assets && vite build && npm run build:server",
    "build:server": "esbuild src/server-node/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs --packages=external",
    "gen:assets": "tsx tools/gen-assets.ts",
    "server": "tsx src/server-node/main.ts",
    "start": "node dist-server/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:mp": "node tests/e2e/multiplayer.mjs",
    "test:e2e:v1": "node tests/e2e/v1.mjs",
    "test:e2e:render": "node tests/e2e/render-equivalence.mjs",
    "test:e2e:v4": "node tests/e2e/v4.mjs",
    "test:e2e:v5": "node tests/e2e/v5.mjs",
    "bench": "node tests/perf/bench.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fflate": "^0.8.3",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
